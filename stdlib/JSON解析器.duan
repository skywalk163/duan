def解析JSON(字符串):
    return_解析JSON(字符串)


def生成JSON(对象,缩进=无,确保ASCII=真):
    return_生成JSON(对象,缩进=缩进,确保ASCII=确保ASCII)


def读取JSON文件(文件路径):
    打开(文件路径,'r',编码='utf-8')作为f:
        return_解析JSON文件(f)


def写入JSON文件(文件路径,对象,缩进=2,确保ASCII=假):
    打开(文件路径,'w',编码='utf-8')作为f:
        _写入JSON文件(f,对象,缩进=缩进,确保ASCII=确保ASCII)


defJSON转字典(字符串):
    return_解析JSON(字符串)


def字典转JSON(字典,缩进=无):
    return_生成JSON(字典,缩进=缩进,确保ASCII=假)


defJSON转列表(字符串):
    return_解析JSON(字符串)


def列表转JSON(列表,缩进=无):
    return_生成JSON(列表,缩进=缩进,确保ASCII=假)


defJSON格式化(字符串,缩进=2):
    对象=_解析JSON(字符串)
    return_生成JSON(对象,缩进=缩进,确保ASCII=假)


defJSON压缩(字符串):
    对象=_解析JSON(字符串)
    return_生成JSON(对象,分隔符=(',',':'),确保ASCII=假)


defJSON验证(字符串):
    尝试:
        _解析JSON(字符串)
        返回真
    除值错误:
        返回假


defJSON合并(*对象列表):
    结果={}
    对于obj在对象列表:
        如果是字典(obj):
            结果.更新(obj)
    返回结果


defJSON深拷贝(对象):
    return_解析JSON(_生成JSON(对象))


defJSON提取值(字符串,路径):
    对象=_解析JSON(字符串)
    当前=对象
    对于键在路径.分割('.'):
        如果是字典(当前)且键在当前:
            当前=当前[键]
        否则如果是列表(当前)且键.是数字():
            当前=当前[整数(键)]
        否则:
            返回无
    返回当前


defJSON设置值(字符串,路径,值):
    对象=_解析JSON(字符串)
    当前=对象
    键列表=路径.分割('.')
    
    对于i,键在枚举(键列表[:-1]):
        如果是字典(当前)且键在当前:
            当前=当前[键]
        否则如果是列表(当前)且键.是数字():
            当前=当前[整数(键)]
        否则:
            返回字符串
    
    最后键=键列表[-1]
    如果是字典(当前):
        当前[最后键]=值
    否则如果是列表(当前)且最后键.是数字():
        当前[整数(最后键)]=值
    
    返回_生成JSON(对象,缩进=2,确保ASCII=假)


defJSON删除键(字符串,路径):
    对象=_解析JSON(字符串)
    当前=对象
    键列表=路径.分割('.')
    
    对于i,键在枚举(键列表[:-1]):
        如果是字典(当前)且键在当前:
            当前=当前[键]
        否则如果是列表(当前)且键.是数字():
            当前=当前[整数(键)]
        否则:
            返回字符串
    
    最后键=键列表[-1]
    如果是字典(当前)且最后键在当前:
        删除当前[最后键]
    否则如果是列表(当前)且最后键.是数字():
        删除当前[整数(最后键)]
    
    返回_生成JSON(对象,缩进=2,确保ASCII=假)


defJSON遍历(字符串,回调函数):
    对象=_解析JSON(字符串)
    
    def递归遍历(当前,路径=''):
        如果是字典(当前):
            对于键,值在当前.项():
                回调函数(f'{路径}.{键}'如果路径否则键,值)
                递归遍历(值,f'{路径}.{键}'如果路径否则键)
        否则如果是列表(当前):
            对于i,值在枚举(当前):
                回调函数(f'{路径}[{i}]',值)
                递归遍历(值,f'{路径}[{i}]')
    
    递归遍历(对象)


defJSON查找(字符串,键):
    结果=[]
    对象=_解析JSON(字符串)
    
    def递归查找(当前):
        如果是字典(当前):
            如果键在当前:
                结果.追加(当前[键])
            对于值在当前.值():
                递归查找(值)
        否则如果是列表(当前):
            对于值在当前:
                递归查找(值)
    
    递归查找(对象)
    返回结果


defJSON计数(字符串):
    对象=_解析JSON(字符串)
    计数={'dict':0,'list':0,'str':0,'int':0,'float':0,'bool':0,'null':0}
    
    def递归计数(当前):
        如果是字典(当前):
            计数['dict']+=1
            对于值在当前.值():
                递归计数(值)
        否则如果是列表(当前):
            计数['list']+=1
            对于值在当前:
                递归计数(值)
        否则如果是字符串(当前):
            计数['str']+=1
        否则如果是整数(当前):
            计数['int']+=1
        否则如果是浮点数(当前):
            计数['float']+=1
        否则如果是布尔(当前):
            计数['bool']+=1
        否则如果当前是无:
            计数['null']+=1
    
    递归计数(对象)
    返回计数


defJSON转CSV(字符串,输出文件=无):
    对象=_解析JSON(字符串)
    
    如果不是列表(对象):
        抛出值错误('JSON必须是数组格式')
    
    如果不是对象:
        返回''
    
    表头=集合()
    对于项在对象:
        如果是字典(项):
            表头.更新(项.键())
    表头=列表(表头)
    
    行=[_连接(表头,',')]
    对于项在对象:
        单元格=[]
        对于列在表头:
            值=项.获取(列,'')
            如果是字符串(值):
                值=值.替换('"','""')
                单元格.追加(f'"{值}"')
            否则:
                单元格.追加(转字符串(值))
        行.追加(_连接(单元格,','))
    
    CSV内容=_连接(行,'\n')
    
    如果输出文件:
        打开(输出文件,'w',编码='utf-8')作为f:
            f.写入(CSV内容)
    
    返回CSV内容


defJSON获取大小(字符串):
    返回长度(字符串.编码('utf-8'))