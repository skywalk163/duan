导入os
导入sys
导入traceback
导入json
from datetime import datetime

_log_level='信息'
_output_file=None
_log_rotation_config=None

级别映射={
    '调试':0,
    '信息':1,
    '警告':2,
    '错误':3,
    '致命':4,
}

def _应该记录(级别):
    return级别映射.get(级别,1)>=级别映射.get(_log_level,1)

def _获取时间戳():
    return datetime.now().strftime('%Y-%m-%d%H:%M:%S.%f')[:-3]

def 设置级别(级别):
    global_log_level
    _log_level=级别

def 获取级别():
    return _log_level

def 设置输出文件(文件路径):
    global_output_file
    if_output_file:
        _output_file.close()
    _output_file=打开(文件路径,'a',encoding='utf-8')

def 设置日志轮转(文件路径,最大大小=1024*1024,备份数量=5):
    global_log_rotation_config
    _log_rotation_config={
        '文件路径':文件路径,
        '最大大小':最大大小,
        '备份数量':备份数量,
    }
    设置输出文件(文件路径)

def _检查轮转():
    if not _log_rotation_config or not _output_file:
        return
    配置=_log_rotation_config
    文件路径=配置['文件路径']
    最大大小=配置['最大大小']
    备份数量=配置['备份数量']
    
    if os.path.exists(文件路径):
        文件大小=os.path.getsize(文件路径)
        if文件大小>=最大大小:
            _执行轮转(文件路径,备份数量)

def _执行轮转(文件路径,备份数量):
    for i in范围(备份数量-1,0,-1):
        旧文件=f'{文件路径}.{i}'
        新文件=f'{文件路径}.{i+1}'
        if os.path.exists(旧文件):
            os.rename(旧文件,新文件)
    os.rename(文件路径,f'{文件路径}.1')
    global_output_file
    _output_file.close()
    _output_file=打开(文件路径,'w',encoding='utf-8')

def _写入日志(级别,消息,**上下文):
    if not _应该记录(级别):
        return
    _检查轮转()
    时间戳=_获取时间戳()
    if上下文:
        上下文字符串=json.dumps(上下文,ensure_ascii=False)
        日志行=f'{时间戳}[{级别}]{消息}{上下文字符串}\n'
    else:
        日志行=f'{时间戳}[{级别}]{消息}\n'
    
    print(日志行,end='')
    if_output_file:
        _output_file.write(日志行)
        _output_file.flush()

def 调试(消息,**上下文):
    _写入日志('调试',消息,**上下文)

def 信息(消息,**上下文):
    _写入日志('信息',消息,**上下文)

def 警告(消息,**上下文):
    _写入日志('警告',消息,**上下文)

def 错误(消息,**上下文):
    _写入日志('错误',消息,**上下文)

def 致命(消息,**上下文):
    _写入日志('致命',消息,**上下文)

def 调试上下文(消息,**上下文):
    调试(消息,**上下文)

def 信息上下文(消息,**上下文):
    信息(消息,**上下文)

def 警告上下文(消息,**上下文):
    警告(消息,**上下文)

def 错误上下文(消息,**上下文):
    错误(消息,**上下文)

def 致命上下文(消息,**上下文):
    致命(消息,**上下文)

def 日志异常(消息='发生异常'):
    异常信息=traceback.format_exc()
    错误(f'{消息}\n{异常信息}')

def 启用控制台输出():
    pass

