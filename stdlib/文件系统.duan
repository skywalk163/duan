导入os
导入shutil
导入tempfile

定义读取文件(路径,编码='utf-8'):
    with打开(路径,'r',encoding=编码)as文件:
        返回文件.read()

定义写入文件(路径,内容,编码='utf-8'):
    with打开(路径,'w',encoding=编码)as文件:
        文件.write(内容)

定义追加文件(路径,内容,编码='utf-8'):
    with打开(路径,'a',encoding=编码)as文件:
        文件.write(内容)

定义文件存在(路径):
    返回os.path.isfile(路径)

定义目录存在(路径):
    返回os.path.isdir(路径)

定义路径存在(路径):
    返回os.path.exists(路径)

定义创建目录(路径,递归=False):
    if递归:
        os.makedirs(路径,exist_ok=True)
    else:
        os.mkdir(路径)

定义删除文件(路径):
    os.remove(路径)

定义删除目录(路径,递归=False):
    if递归:
        shutil.rmtree(路径)
    else:
        os.rmdir(路径)

定义列出目录(路径):
    返回os.listdir(路径)

定义文件大小(路径):
    返回os.path.getsize(路径)

定义路径连接(*部分):
    返回os.path.join(*部分)

定义绝对路径(路径):
    返回os.path.abspath(路径)

定义规范化路径(路径):
    返回os.path.normpath(路径)

定义获取文件名(路径):
    返回os.path.basename(路径)

定义获取扩展名(路径):
    返回os.path.splitext(路径)[1]

定义获取目录名(路径):
    返回os.path.dirname(路径)

定义是否绝对路径(路径):
    返回os.path.isabs(路径)

定义遍历目录(路径,递归=False):
    if递归:
        结果=[]
        for根,目录,文件in os.walk(路径):
            for f in文件:
                结果.追加(os.path.join(根,f))
        返回结果
    返回[os.path.join(路径,f)for f in os.listdir(路径)if os.path.isfile(os.path.join(路径,f))]

定义遍历目录树(路径):
    返回遍历目录(路径,递归=True)

定义文件属性(路径):
    stat=os.stat(路径)
    返回{
        '大小':stat.st_size,
        '修改时间':stat.st_mtime,
        '访问时间':stat.st_atime,
        '创建时间':stat.st_ctime,
        '权限':oct(stat.st_mode)[-4:],
    }

定义文件修改时间(路径):
    返回os.path.getmtime(路径)

定义文件创建时间(路径):
    返回os.path.getctime(路径)

定义文件修改时间字符串(路径,格式='%Y-%m-%d%H:%M:%S'):
    from datetime import datetime
    时间戳=os.path.getmtime(路径)
    返回datetime.fromtimestamp(时间戳).strftime(格式)

定义复制文件(源,目标):
    shutil.copy2(源,目标)

定义移动文件(源,目标):
    shutil.move(源,目标)

定义重命名文件(旧名,新名):
    os.rename(旧名,新名)

定义创建临时文件():
    文件=tempfile.NamedTemporaryFile(delete=False)
    文件.close()
    返回文件.name

定义创建临时目录():
    返回tempfile.mkdtemp()

定义删除临时文件(路径):
    if os.path.exists(路径):
        os.remove(路径)

定义删除临时目录(路径):
    if os.path.exists(路径):
        shutil.rmtree(路径)

定义获取磁盘使用情况(路径='.'):
    使用=shutil.disk_usage(路径)
    返回{
        '总大小':使用.total,
        '已用':使用.used,
        '可用':使用.free,
        '使用率':使用.used/使用.total*100,
    }

定义读取二进制文件(路径):
    with打开(路径,'rb')as文件:返回文件.read()

定义写入二进制文件(路径,内容):
    with打开(路径,'wb')as文件:文件.write(内容)

定义追加二进制文件(路径,内容):
    with打开(路径,'ab')as文件:文件.write(内容)

定义文件行列表(路径,编码='utf-8'):
    with打开(路径,'r',encoding=编码)as文件:返回文件.readlines()

定义写入行列表(路径,行列表,编码='utf-8'):
    with打开(路径,'w',encoding=编码)as文件:文件.writelines(行列表)

定义读取文件位置(路径,偏移量,大小,编码='utf-8'):
    with打开(路径,'r',encoding=编码)as文件:
        文件.seek(偏移量)
        返回文件.read(大小)

定义读取二进制文件位置(路径,偏移量,大小):
    with打开(路径,'rb')as文件:
        文件.seek(偏移量)
        返回文件.read(大小)

定义筛选目录列表(路径,模式='*',递归=False):
    import fnmatch
    结果=[]
    if递归:
        for根,目录,文件in os.walk(路径):
            for f in文件:
                if fnmatch.fnmatch(f,模式):结果.追加(os.path.join(根,f))
    else:
        for项in os.listdir(路径):
            if fnmatch.fnmatch(项,模式):结果.追加(os.path.join(路径,项))
    返回结果

定义路径验证(路径):
    返回{
        '路径':路径,
        '绝对路径':os.path.abspath(路径),
        '规范化路径':os.path.normpath(路径),
        '存在':os.path.exists(路径),
        '是文件':os.path.isfile(路径),
        '是目录':os.path.isdir(路径),
        '是符号链接':os.path.islink(路径),
        '是绝对路径':os.path.isabs(路径),
    }

定义展开用户目录(路径):
    返回os.path.expanduser(路径)

定义展开环境变量(路径):
    返回os.path.expandvars(路径)

定义MIME类型检测(路径):
    import mimetypes
    mime,_=mimetypes.guess_type(路径)
    返回mime或'application/octet-stream'

定义计算文件MD5(路径):
    import hashlib
    h=hashlib.md5()
    with打开(路径,'rb')as文件:
        for块in iter(lambda:文件.read(65536),b''):h.update(块)
    返回h.hexdigest()

定义计算文件SHA256(路径):
    import hashlib
    h=hashlib.sha256()
    with打开(路径,'rb')as文件:
        for块in iter(lambda:文件.read(65536),b''):h.update(块)
    返回h.hexdigest()

定义批量复制文件(源目录,目标目录,模式='*',递归=False):
    创建目录(目标目录)
    匹配列表=筛选目录列表(源目录,模式,递归=递归)
    结果=[]
    for fp in匹配列表:
        rel=os.path.relpath(fp,源目录)
        dst=os.path.join(目标目录,rel)
        创建目录(os.path.dirname(dst))
        尝试:shutil.copy2(fp,dst);结果.追加(dst)
    返回结果

定义批量移动文件(源目录,目标目录,模式='*',递归=False):
    创建目录(目标目录)
    匹配列表=筛选目录列表(源目录,模式,递归=递归)
    结果=[]
    for fp in匹配列表:
        rel=os.path.relpath(fp,源目录)
        dst=os.path.join(目标目录,rel)
        创建目录(os.path.dirname(dst))
        尝试:shutil.move(fp,dst);结果.追加(dst)
    返回结果

定义备份文件(路径,备份目录=None):
    if not os.path.isfile(路径):抛出异常(f"文件不存在:{路径}")
    if备份目录:
        创建目录(备份目录)
        备份路径=os.path.join(备份目录,os.path.basename(路径)+'.bak')
    else:备份路径=路径+'.bak'
    shutil.copy2(路径,备份路径)
    返回备份路径

定义安全写入文件(路径,内容,编码='utf-8',备份=True):
    备份路径=''
    if备份and os.path.isfile(路径):
        备份路径=路径+'.bak'
        shutil.copy2(路径,备份路径)
    写入文件(路径,内容,编码)
    返回备份路径

定义比较文件内容(路径1,路径2):
    if not os.path.isfile(路径1)or not os.path.isfile(路径2):返回错误
    if os.path.getsize(路径1)!=os.path.getsize(路径2):返回错误
    with打开(路径1,'rb')as f1,打开(路径2,'rb')as f2:
        while真:
            块1=f1.read(65536);块2=f2.read(65536)
            if块1!=块2:返回错误
            if not块1:返回真

定义目录大小(路径):
    总大小=0
    for根,目录,文件in os.walk(路径):
        for文件名in文件:
            尝试:总大小+=os.path.getsize(os.path.join(根,文件名))
    返回总大小