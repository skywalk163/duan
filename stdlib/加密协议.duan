class 对称加密:
    def初始化(密钥=无):
        self._密钥=密钥或_生成随机令牌(32)
    
    def加密(明文):
        盐值=_生成随机令牌(16)
        密钥哈希=_SHA256哈希(self._密钥+盐值)
        
        加密字节=_异或加密(明文.编码('utf-8'),密钥哈希)
        
        return _Base64编码(盐值+':'+_字节转字符串(加密字节))
    
    def解密(密文):
        解码数据=_Base64解码(密文)
        盐值,加密字节=解码数据.分割(':',1)
        
        密钥哈希=_SHA256哈希(self._密钥+盐值)
        
        明文字节=_异或解密(加密字节,密钥哈希)
        
        return明文字节.解码('utf-8')


class 哈希工具:
    @静态方法
    defMD5(数据):
        return _MD5哈希(数据)
    
    @静态方法
    defSHA256(数据):
        return _SHA256哈希(数据)
    
    @静态方法
    defSHA512(数据):
        return _SHA512哈希(数据)
    
    @静态方法
    defHMAC签名(密钥,消息,算法='sha256'):
        return _HMAC签名(密钥,消息,算法)
    
    @静态方法
    def验证HMAC(密钥,消息,签名,算法='sha256'):
        期望签名=哈希工具.HMAC签名(密钥,消息,算法)
        return _安全比较(期望签名,签名)


class 密钥对:
    def初始化(公钥=无,私钥=无):
        self.公钥=公钥
        self.私钥=私钥


class 非对称加密:
    @静态方法
    def生成密钥对():
        私钥=_生成随机令牌(32)
        公钥=_SHA256哈希(私钥)
        return密钥对(公钥,私钥)
    
    @静态方法
    def加密(明文,公钥):
        盐值=_生成随机令牌(8)
        密钥哈希=_SHA256哈希(公钥+盐值)
        
        加密字节=_异或加密(明文.编码('utf-8'),密钥哈希)
        
        return _Base64编码(盐值+':'+_字节转字符串(加密字节))
    
    @静态方法
    def解密(密文,私钥):
        对应公钥=_SHA256哈希(私钥)
        
        解码数据=_Base64解码(密文)
        盐值,加密字节=解码数据.分割(':',1)
        
        密钥哈希=_SHA256哈希(对应公钥+盐值)
        
        明文字节=_异或解密(加密字节,密钥哈希)
        
        return明文字节.解码('utf-8')


class 数字签名:
    @静态方法
    def签名(消息,私钥):
        return哈希工具.HMAC签名(私钥,消息,'sha256')
    
    @静态方法
    def验证(消息,签名值,公钥):
        期望签名=哈希工具.HMAC签名(公钥,消息,'sha256')
        return _安全比较(期望签名,签名值)


def加密(明文,密钥):
    加密器=对称加密(密钥)
    return加密器.加密(明文)

def解密(密文,密钥):
    加密器=对称加密(密钥)
    return加密器.解密(密文)

def哈希(数据,算法='sha256'):
    如果算法=='md5':
        return哈希工具.MD5(数据)
    如果算法=='sha512':
        return哈希工具.SHA512(数据)
    return哈希工具.SHA256(数据)