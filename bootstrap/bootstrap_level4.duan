# 段言自举编译器 - Level 4
# 支持完整的面向对象：属性访问、方法调用、继承
# 基于 Level 3，增加类的完整支持

段落 关键字列表：
  返回 列表创建("设", "段落", "段", "返回", "结束", "为", "如果", "否则", "当", "接收", "加", "减", "乘", "除", "取模", "等于", "小于", "大于", "小于等于", "大于等于", "不等于", "且", "或", "非", "遍历", "在", "类", "属性", "己", "继承", "父")

段落 是关键字 接收 w：
  定义 kws 等于 关键字列表()
  定义 i 等于 0
  当 i 小于 列表长度(kws)：
    如果 列表获取(kws, i) 等于 w：
      返回 真
    定义 i 等于 i 加 1
  返回 假

段落 是函数关键字 接收 w：
  如果 w 等于 "段落"：
    返回 真
  如果 w 等于 "段"：
    返回 真
  返回 假

段落 建 接收 t, v：
  返回 列表创建(t, v)

段落 词 接收 src, p, n, s：
  当 p 小于 n：
    定义 c 等于 字符串获取(src, p)
    定义 是分隔符 等于 假
    如果 c 等于 "："：
      定义 是分隔符 等于 真
    如果 c 等于 "。"：
      定义 是分隔符 等于 真
    如果 c 等于 "，"：
      定义 是分隔符 等于 真
    如果 是分隔符 等于 真：
      如果 s 等于 ""：
        返回 建("EOF", "")
      如果 是关键字(s)：
        返回 建("KW", s)
      返回 建("ID", s)
    定义 是字母 等于 假
    如果 c 等于 "_"：
      定义 是字母 等于 真
    如果 c 大于等于 "a"：
      如果 c 小于等于 "z"：
        定义 是字母 等于 真
    如果 c 大于等于 "A"：
      如果 c 小于等于 "Z"：
        定义 是字母 等于 真
    如果 c 大于等于 "一"：
      定义 是字母 等于 真
    如果 是字母 等于 真：
      定义 s 等于 s 加 c
      定义 p 等于 p 加 1
    否则：
      定义 是数字 等于 假
      如果 c 大于等于 "0"：
        如果 c 小于等于 "9"：
          定义 是数字 等于 真
      如果 是数字 等于 真：
        如果 s 不等于 ""：
          定义 s 等于 s 加 c
          定义 p 等于 p 加 1
        否则：
          如果 s 等于 ""：
            返回 建("EOF", "")
          如果 是关键字(s)：
            返回 建("KW", s)
          返回 建("ID", s)
      否则：
        如果 s 等于 ""：
          返回 建("EOF", "")
        如果 是关键字(s)：
          返回 建("KW", s)
        返回 建("ID", s)
  如果 s 等于 ""：
    返回 建("EOF", "")
  如果 是关键字(s)：
    返回 建("KW", s)
  返回 建("ID", s)

段落 数字 接收 src, p, n, s：
  当 p 小于 n：
    定义 c 等于 字符串获取(src, p)
    如果 c 大于等于 "0" 且 c 小于等于 "9"：
      定义 s 等于 s 加 c
      定义 p 等于 p 加 1
    否则：
      返回 建("NUM", s)
  返回 建("NUM", s)

段落 字符串 接收 src, p, n, s：
  当 p 小于 n：
    定义 c 等于 字符串获取(src, p)
    如果 c 等于 '"'：
      定义 tok 等于 建("STR", s)
      返回 列表创建(tok, p 加 1)
    定义 s 等于 s 加 c
    定义 p 等于 p 加 1
  定义 tok 等于 建("STR", s)
  返回 列表创建(tok, p)

段落 扫注释 接收 src, p, n：
  当 p 小于 n：
    定义 c 等于 字符串获取(src, p)
    如果 c 等于 "\n"：
      返回 p 加 1
    定义 p 等于 p 加 1
  返回 p

段落 扫 接收 src, p, n, toks：
  当 p 小于 n：
    定义 c 等于 字符串获取(src, p)
    定义 已处理 等于 假
    如果 c 等于 " "：
      定义 p 等于 p 加 1
      定义 已处理 等于 真
    如果 已处理 等于 假 且 c 等于 "\n"：
      定义 p 等于 p 加 1
      定义 已处理 等于 真
    如果 已处理 等于 假 且 c 等于 "#"：
      定义 p 等于 扫注释(src, p 加 1, n)
      定义 已处理 等于 真
    如果 已处理 等于 假 且 c 等于 "'"：
      如果 p 加 1 小于 n：
        定义 nc 等于 字符串获取(src, p 加 1)
        如果 nc 等于 '"'：
          列表追加(toks, 建("STR", '"'))
          定义 p 等于 p 加 3
          定义 已处理 等于 真
      如果 已处理 等于 假：
        定义 p 等于 p 加 1
        定义 已处理 等于 真
    如果 已处理 等于 假 且 c 等于 '"'：
      如果 p 加 1 小于 n：
        定义 nc 等于 字符串获取(src, p 加 1)
        如果 nc 等于 "'"：
          列表追加(toks, 建("STR", "'"))
          定义 p 等于 p 加 3
          定义 已处理 等于 真
      如果 已处理 等于 假：
        定义 结果 等于 字符串(src, p 加 1, n, "")
        定义 tok 等于 列表获取(结果, 0)
        定义 p 等于 列表获取(结果, 1)
        列表追加(toks, tok)
        定义 已处理 等于 真
    如果 已处理 等于 假 且 c 等于 "："：
      定义 p 等于 p 加 1
      定义 已处理 等于 真
    如果 已处理 等于 假 且 c 等于 "。"：
      定义 p 等于 p 加 1
      定义 已处理 等于 真
    如果 已处理 等于 假 且 c 等于 "，"：
      定义 p 等于 p 加 1
      定义 已处理 等于 真
    如果 已处理 等于 假 且 c 等于 "("：
      列表追加(toks, 建("LPAREN", "("))
      定义 p 等于 p 加 1
      定义 已处理 等于 真
    如果 已处理 等于 假 且 c 等于 ")"：
      列表追加(toks, 建("RPAREN", ")"))
      定义 p 等于 p 加 1
      定义 已处理 等于 真
    如果 已处理 等于 假 且 c 等于 ","：
      列表追加(toks, 建("COMMA", ","))
      定义 p 等于 p 加 1
      定义 已处理 等于 真
    如果 已处理 等于 假 且 c 等于 "."：
      列表追加(toks, 建("DOT", "."))
      定义 p 等于 p 加 1
      定义 已处理 等于 真
    如果 已处理 等于 假 且 c 大于等于 "0"：
      如果 c 小于等于 "9"：
        定义 tok 等于 数字(src, p, n, "")
        列表追加(toks, tok)
        定义 p 等于 p 加 字符串长度(列表获取(tok, 1))
        定义 已处理 等于 真
    如果 已处理 等于 假 且 c 大于等于 "a"：
      定义 tok 等于 词(src, p, n, "")
      列表追加(toks, tok)
      定义 p 等于 p 加 字符串长度(列表获取(tok, 1))
      定义 已处理 等于 真
    如果 已处理 等于 假 且 c 大于等于 "A"：
      定义 tok 等于 词(src, p, n, "")
      列表追加(toks, tok)
      定义 p 等于 p 加 字符串长度(列表获取(tok, 1))
      定义 已处理 等于 真
    如果 已处理 等于 假 且 c 大于等于 "一"：
      定义 tok 等于 词(src, p, n, "")
      列表追加(toks, tok)
      定义 p 等于 p 加 字符串长度(列表获取(tok, 1))
      定义 已处理 等于 真
    如果 已处理 等于 假：
      定义 p 等于 p 加 1
  返回 toks

段落 词法 接收 src：
  返回 扫(src, 0, 字符串长度(src), 列表创建())

段落 表达式 接收 toks, p：
  返回 或表达式(toks, p)

段落 或表达式 接收 toks, p：
  定义 结果 等于 且表达式(toks, p)
  定义 left 等于 列表获取(结果, 0)
  定义 np 等于 列表获取(结果, 1)
  定义 继续循环 等于 真
  当 继续循环 且 np 小于 列表长度(toks)：
    定义 tok 等于 列表获取(toks, np)
    定义 tv 等于 列表获取(tok, 1)
    如果 tv 不等于 "或"：
      定义 继续循环 等于 假
    否则：
      定义 右结果 等于 且表达式(toks, np 加 1)
      定义 right 等于 列表获取(右结果, 0)
      定义 np 等于 列表获取(右结果, 1)
      定义 left 等于 left 加 " or " 加 right
  返回 列表创建(left, np)

段落 且表达式 接收 toks, p：
  定义 结果 等于 比较表达式(toks, p)
  定义 left 等于 列表获取(结果, 0)
  定义 np 等于 列表获取(结果, 1)
  定义 继续循环 等于 真
  当 继续循环 且 np 小于 列表长度(toks)：
    定义 tok 等于 列表获取(toks, np)
    定义 tv 等于 列表获取(tok, 1)
    如果 tv 不等于 "且"：
      定义 继续循环 等于 假
    否则：
      定义 右结果 等于 比较表达式(toks, np 加 1)
      定义 right 等于 列表获取(右结果, 0)
      定义 np 等于 列表获取(右结果, 1)
      定义 left 等于 left 加 " and " 加 right
  返回 列表创建(left, np)

段落 比较表达式 接收 toks, p：
  定义 结果 等于 加减表达式(toks, p)
  定义 left 等于 列表获取(结果, 0)
  定义 np 等于 列表获取(结果, 1)
  如果 np 小于 列表长度(toks)：
    定义 tok 等于 列表获取(toks, np)
    定义 tv 等于 列表获取(tok, 1)
    如果 tv 等于 "等于"：
      定义 右结果 等于 加减表达式(toks, np 加 1)
      定义 right 等于 列表获取(右结果, 0)
      定义 np 等于 列表获取(右结果, 1)
      返回 列表创建(left 加 " == " 加 right, np)
    如果 tv 等于 "小于"：
      定义 右结果 等于 加减表达式(toks, np 加 1)
      定义 right 等于 列表获取(右结果, 0)
      定义 np 等于 列表获取(右结果, 1)
      返回 列表创建(left 加 " < " 加 right, np)
    如果 tv 等于 "大于"：
      定义 右结果 等于 加减表达式(toks, np 加 1)
      定义 right 等于 列表获取(右结果, 0)
      定义 np 等于 列表获取(右结果, 1)
      返回 列表创建(left 加 " > " 加 right, np)
    如果 tv 等于 "小于等于"：
      定义 右结果 等于 加减表达式(toks, np 加 1)
      定义 right 等于 列表获取(右结果, 0)
      定义 np 等于 列表获取(右结果, 1)
      返回 列表创建(left 加 " <= " 加 right, np)
    如果 tv 等于 "大于等于"：
      定义 右结果 等于 加减表达式(toks, np 加 1)
      定义 right 等于 列表获取(右结果, 0)
      定义 np 等于 列表获取(右结果, 1)
      返回 列表创建(left 加 " >= " 加 right, np)
    如果 tv 等于 "不等于"：
      定义 右结果 等于 加减表达式(toks, np 加 1)
      定义 right 等于 列表获取(右结果, 0)
      定义 np 等于 列表获取(右结果, 1)
      返回 列表创建(left 加 " != " 加 right, np)
  返回 列表创建(left, np)

段落 加减表达式 接收 toks, p：
  定义 结果 等于 乘除表达式(toks, p)
  定义 left 等于 列表获取(结果, 0)
  定义 np 等于 列表获取(结果, 1)
  定义 继续循环 等于 真
  当 继续循环 且 np 小于 列表长度(toks)：
    定义 tok 等于 列表获取(toks, np)
    定义 tv 等于 列表获取(tok, 1)
    如果 tv 等于 "加"：
      定义 右结果 等于 乘除表达式(toks, np 加 1)
      定义 right 等于 列表获取(右结果, 0)
      定义 np 等于 列表获取(右结果, 1)
      定义 left 等于 left 加 " + " 加 right
    否则：
      如果 tv 等于 "减"：
        定义 右结果 等于 乘除表达式(toks, np 加 1)
        定义 right 等于 列表获取(右结果, 0)
        定义 np 等于 列表获取(右结果, 1)
        定义 left 等于 left 加 " - " 加 right
      否则：
        定义 继续循环 等于 假
  返回 列表创建(left, np)

段落 乘除表达式 接收 toks, p：
  定义 结果 等于 成员表达式(toks, p)
  定义 left 等于 列表获取(结果, 0)
  定义 np 等于 列表获取(结果, 1)
  定义 继续循环 等于 真
  当 继续循环 且 np 小于 列表长度(toks)：
    定义 tok 等于 列表获取(toks, np)
    定义 tv 等于 列表获取(tok, 1)
    如果 tv 等于 "乘"：
      定义 右结果 等于 成员表达式(toks, np 加 1)
      定义 right 等于 列表获取(右结果, 0)
      定义 np 等于 列表获取(右结果, 1)
      定义 left 等于 left 加 " * " 加 right
    否则：
      如果 tv 等于 "除"：
        定义 右结果 等于 成员表达式(toks, np 加 1)
        定义 right 等于 列表获取(右结果, 0)
        定义 np 等于 列表获取(右结果, 1)
        定义 left 等于 left 加 " // " 加 right
      否则：
        如果 tv 等于 "取模"：
          定义 右结果 等于 成员表达式(toks, np 加 1)
          定义 right 等于 列表获取(右结果, 0)
          定义 np 等于 列表获取(右结果, 1)
          定义 left 等于 left 加 " % " 加 right
        否则：
          定义 继续循环 等于 假
  返回 列表创建(left, np)

段落 成员表达式 接收 toks, p：
  定义 结果 等于 一元表达式(toks, p)
  定义 left 等于 列表获取(结果, 0)
  定义 np 等于 列表获取(结果, 1)
  返回 处理成员链(toks, np, left)

段落 处理成员链 接收 toks, p, left：
  定义 np 等于 p
  当 np 小于 列表长度(toks)：
    定义 dot_tok 等于 列表获取(toks, np)
    如果 列表获取(dot_tok, 0) 等于 "DOT"：
      定义 np 等于 np 加 1
      如果 np 小于 列表长度(toks)：
        定义 attr_tok 等于 列表获取(toks, np)
        定义 attr_name 等于 列表获取(attr_tok, 1)
        定义 np 等于 np 加 1
        如果 np 小于 列表长度(toks)：
          定义 next_tok 等于 列表获取(toks, np)
          如果 列表获取(next_tok, 0) 等于 "LPAREN"：
            定义 参数结果 等于 解析参数列表(toks, np 加 1)
            定义 args 等于 列表获取(参数结果, 0)
            定义 np 等于 列表获取(参数结果, 1)
            定义 left 等于 left 加 "." 加 attr_name 加 "(" 加 args 加 ")"
          否则：
            定义 left 等于 left 加 "." 加 attr_name
        否则：
          定义 left 等于 left 加 "." 加 attr_name
    否则：
      返回 列表创建(left, np)
  返回 列表创建(left, np)

段落 一元表达式 接收 toks, p：
  如果 p 小于 列表长度(toks)：
    定义 tok 等于 列表获取(toks, p)
    如果 列表获取(tok, 0) 等于 "KW" 且 列表获取(tok, 1) 等于 "非"：
      定义 结果 等于 一元表达式(toks, p 加 1)
      定义 expr 等于 列表获取(结果, 0)
      定义 np 等于 列表获取(结果, 1)
      返回 列表创建("not " 加 expr, np)
    如果 列表获取(tok, 0) 等于 "KW" 且 列表获取(tok, 1) 等于 "己"：
      返回 处理成员链(toks, p 加 1, "self")
    如果 列表获取(tok, 0) 等于 "KW" 且 列表获取(tok, 1) 等于 "父"：
      返回 处理成员链(toks, p 加 1, "super()")
    如果 列表获取(tok, 0) 等于 "LPAREN"：
      定义 结果 等于 表达式(toks, p 加 1)
      定义 expr 等于 列表获取(结果, 0)
      定义 np 等于 列表获取(结果, 1)
      如果 np 小于 列表长度(toks)：
        定义 tok 等于 列表获取(toks, np)
        如果 列表获取(tok, 0) 等于 "RPAREN"：
          返回 列表创建(expr, np 加 1)
      返回 列表创建(expr, np)
    如果 列表获取(tok, 0) 等于 "NUM"：
      返回 列表创建(列表获取(tok, 1), p 加 1)
    如果 列表获取(tok, 0) 等于 "STR"：
      定义 s 等于 列表获取(tok, 1)
      定义 有单引号 等于 假
      定义 i 等于 0
      当 i 小于 字符串长度(s)：
        如果 字符串获取(s, i) 等于 "'"：
          定义 有单引号 等于 真
        定义 i 等于 i 加 1
      如果 有单引号：
        返回 列表创建('"' 加 s 加 '"', p 加 1)
      返回 列表创建("'" 加 s 加 "'", p 加 1)
    如果 列表获取(tok, 0) 等于 "ID"：
      定义 name 等于 列表获取(tok, 1)
      定义 np 等于 p 加 1
      如果 np 小于 列表长度(toks)：
        定义 tok 等于 列表获取(toks, np)
        如果 列表获取(tok, 0) 等于 "LPAREN"：
          定义 参数结果 等于 解析参数列表(toks, np 加 1)
          定义 args 等于 列表获取(参数结果, 0)
          定义 np 等于 列表获取(参数结果, 1)
          返回 列表创建(name 加 "(" 加 args 加 ")", np)
      返回 列表创建(name, np)
  返回 列表创建("None", p)

段落 解析参数列表 接收 toks, p：
  如果 p 小于 列表长度(toks)：
    定义 tok 等于 列表获取(toks, p)
    如果 列表获取(tok, 0) 等于 "RPAREN"：
      返回 列表创建("", p 加 1)
    定义 结果 等于 表达式(toks, p)
    定义 first 等于 列表获取(结果, 0)
    定义 np 等于 列表获取(结果, 1)
    定义 剩余结果 等于 解析更多参数(toks, np, first)
    返回 剩余结果
  返回 列表创建("", p)

段落 解析更多参数 接收 toks, p, acc：
  当 p 小于 列表长度(toks)：
    定义 tok 等于 列表获取(toks, p)
    如果 列表获取(tok, 0) 等于 "RPAREN"：
      返回 列表创建(acc, p 加 1)
    如果 列表获取(tok, 0) 等于 "COMMA"：
      定义 结果 等于 表达式(toks, p 加 1)
      定义 next_arg 等于 列表获取(结果, 0)
      定义 np 等于 列表获取(结果, 1)
      定义 acc 等于 acc 加 ", " 加 next_arg
      定义 p 等于 np
    否则：
      定义 p 等于 p 加 1
  返回 列表创建(acc, p)

段落 find_ret 接收 toks, p：
  如果 p 小于 列表长度(toks)：
    定义 tok 等于 列表获取(toks, p)
    如果 列表获取(tok, 1) 等于 "返回"：
      定义 结果 等于 表达式(toks, p 加 1)
      定义 expr 等于 列表获取(结果, 0)
      定义 np 等于 列表获取(结果, 1)
      返回 列表创建("return " 加 expr, np)
  返回 列表创建("pass", p)

段落 find_end 接收 toks, p：
  当 p 小于 列表长度(toks)：
    定义 tok 等于 列表获取(toks, p)
    如果 列表获取(tok, 0) 等于 "KW"：
      如果 列表获取(tok, 1) 等于 "结束"：
        返回 p 加 1
      如果 是函数关键字(列表获取(tok, 1))：
        返回 p
    定义 p 等于 p 加 1
  返回 p

段落 find_next 接收 toks, p：
  当 p 小于 列表长度(toks)：
    定义 tok 等于 列表获取(toks, p)
    如果 列表获取(tok, 0) 等于 "KW"：
      定义 tv 等于 列表获取(tok, 1)
      如果 是函数关键字(tv)：
        返回 p
      如果 tv 等于 "结束"：
        返回 p
      如果 tv 等于 "设"：
        返回 p
      如果 tv 等于 "如果"：
        返回 p
      如果 tv 等于 "返回"：
        返回 p
    定义 p 等于 p 加 1
  返回 p

段落 comp_set 接收 toks, p：
  如果 p 小于 列表长度(toks)：
    定义 tok 等于 列表获取(toks, p)
    如果 列表获取(tok, 1) 等于 "设"：
      定义 np 等于 p 加 1
      如果 np 小于 列表长度(toks)：
        定义 first_tok 等于 列表获取(toks, np)
        如果 列表获取(first_tok, 0) 等于 "KW" 且 列表获取(first_tok, 1) 等于 "己"：
          定义 var_expr 等于 "self"
          定义 np 等于 np 加 1
          定义 继续循环 等于 真
          当 继续循环 等于 真 且 np 小于 列表长度(toks)：
            定义 dot_tok 等于 列表获取(toks, np)
            如果 列表获取(dot_tok, 0) 等于 "DOT"：
              定义 np 等于 np 加 1
              如果 np 小于 列表长度(toks)：
                定义 attr_tok 等于 列表获取(toks, np)
                定义 attr_name 等于 列表获取(attr_tok, 1)
                定义 var_expr 等于 var_expr 加 "." 加 attr_name
                定义 np 等于 np 加 1
            否则：
              定义 继续循环 等于 假
          如果 np 小于 列表长度(toks)：
            定义 tok 等于 列表获取(toks, np)
            如果 列表获取(tok, 1) 等于 "为"：
              定义 np 等于 np 加 1
              定义 结果 等于 表达式(toks, np)
              定义 expr 等于 列表获取(结果, 0)
              定义 np 等于 列表获取(结果, 1)
              返回 列表创建(var_expr 加 " = " 加 expr, np)
        否则：
          定义 var 等于 列表获取(first_tok, 1)
          定义 np 等于 np 加 1
          如果 np 小于 列表长度(toks)：
            定义 tok 等于 列表获取(toks, np)
            如果 列表获取(tok, 1) 等于 "为"：
              定义 np 等于 np 加 1
              定义 结果 等于 表达式(toks, np)
              定义 expr 等于 列表获取(结果, 0)
              定义 np 等于 列表获取(结果, 1)
              返回 列表创建(var 加 " = " 加 expr, np)
      返回 列表创建("", p 加 1)
  返回 列表创建("", p)

段落 find_matching_end 接收 toks, p, level：
  当 p 小于 列表长度(toks)：
    定义 tok 等于 列表获取(toks, p)
    如果 列表获取(tok, 0) 等于 "KW"：
      定义 tv 等于 列表获取(tok, 1)
      如果 tv 等于 "如果"：
        定义 level 等于 level 加 1
      如果 tv 等于 "当"：
        定义 level 等于 level 加 1
      如果 tv 等于 "遍历"：
        定义 level 等于 level 加 1
      如果 tv 等于 "类"：
        定义 level 等于 level 加 1
      如果 tv 等于 "段落"：
        定义 level 等于 level 加 1
      如果 tv 等于 "段"：
        定义 level 等于 level 加 1
      如果 tv 等于 "否则"：
        如果 level 等于 1：
          返回 p
      如果 tv 等于 "结束"：
        如果 level 等于 1：
          返回 p 加 1
        定义 level 等于 level 减 1
    定义 p 等于 p 加 1
  返回 p

段落 compile_block 接收 toks, p, end_p, indent, out：
  当 p 小于 end_p：
    如果 p 小于 列表长度(toks)：
      定义 tok 等于 列表获取(toks, p)
      定义 tv 等于 列表获取(tok, 1)
      定义 已处理 等于 假
      如果 tv 等于 "设"：
        定义 结果 等于 comp_set(toks, p)
        定义 stmt 等于 列表获取(结果, 0)
        定义 np 等于 列表获取(结果, 1)
        定义 out 等于 out 加 indent 加 stmt 加 "\n"
        定义 p 等于 np
        定义 已处理 等于 真
      如果 已处理 等于 假 且 tv 等于 "如果"：
        定义 结果 等于 comp_if(toks, p)
        定义 stmt 等于 列表获取(结果, 0)
        定义 np 等于 列表获取(结果, 1)
        定义 out 等于 out 加 add_indent(stmt, indent)
        定义 p 等于 np
        定义 已处理 等于 真
      如果 已处理 等于 假 且 tv 等于 "当"：
        定义 结果 等于 comp_while(toks, p)
        定义 stmt 等于 列表获取(结果, 0)
        定义 np 等于 列表获取(结果, 1)
        定义 out 等于 out 加 add_indent(stmt, indent)
        定义 p 等于 np
        定义 已处理 等于 真
      如果 已处理 等于 假 且 tv 等于 "遍历"：
        定义 结果 等于 comp_for(toks, p)
        定义 stmt 等于 列表获取(结果, 0)
        定义 np 等于 列表获取(结果, 1)
        定义 out 等于 out 加 add_indent(stmt, indent)
        定义 p 等于 np
        定义 已处理 等于 真
      如果 已处理 等于 假 且 tv 等于 "返回"：
        定义 结果 等于 find_ret(toks, p)
        定义 stmt 等于 列表获取(结果, 0)
        定义 np 等于 列表获取(结果, 1)
        定义 out 等于 out 加 indent 加 stmt 加 "\n"
        定义 p 等于 np
        定义 已处理 等于 真
      如果 已处理 等于 假 且 列表获取(tok, 0) 等于 "ID"：
        定义 np 等于 p 加 1
        如果 np 小于 列表长度(toks)：
          定义 ntok 等于 列表获取(toks, np)
          如果 列表获取(ntok, 0) 等于 "LPAREN"：
            定义 结果 等于 表达式(toks, p)
            定义 stmt 等于 列表获取(结果, 0)
            定义 np 等于 列表获取(结果, 1)
            定义 out 等于 out 加 indent 加 stmt 加 "\n"
            定义 p 等于 np
            定义 已处理 等于 真
          如果 已处理 等于 假 且 列表获取(ntok, 0) 等于 "DOT"：
            定义 结果 等于 表达式(toks, p)
            定义 stmt 等于 列表获取(结果, 0)
            定义 np 等于 列表获取(结果, 1)
            定义 out 等于 out 加 indent 加 stmt 加 "\n"
            定义 p 等于 np
            定义 已处理 等于 真
      如果 已处理 等于 假 且 列表获取(tok, 0) 等于 "KW" 且 tv 等于 "父"：
        定义 np 等于 p 加 1
        如果 np 小于 列表长度(toks)：
          定义 ntok 等于 列表获取(toks, np)
          如果 列表获取(ntok, 0) 等于 "DOT"：
            定义 结果 等于 表达式(toks, p)
            定义 stmt 等于 列表获取(结果, 0)
            定义 np 等于 列表获取(结果, 1)
            定义 out 等于 out 加 indent 加 stmt 加 "\n"
            定义 p 等于 np
            定义 已处理 等于 真
      如果 已处理 等于 假 且 列表获取(tok, 0) 等于 "DOT"：
        定义 已处理 等于 真
        定义 p 等于 p 加 1
      如果 已处理 等于 假 且 tv 等于 "结束"：
        返回 out
      如果 已处理 等于 假：
        定义 p 等于 p 加 1
  返回 out

段落 add_indent 接收 text, indent：
  定义 有尾换行 等于 假
  如果 字符串长度(text) 大于 0：
    定义 末字符 等于 字符串获取(text, 字符串长度(text) 减 1)
    如果 末字符 等于 "\n"：
      定义 有尾换行 等于 真
  如果 有尾换行：
    定义 text 等于 截取(text, 0, 字符串长度(text) 减 1)
  定义 结果 等于 indent 加 加缩进行(text, indent, "", 0)
  如果 有尾换行：
    返回 结果 加 "\n"
  返回 结果

段落 加缩进行 接收 text, indent, acc, i：
  当 i 小于 字符串长度(text)：
    定义 c 等于 字符串获取(text, i)
    如果 c 等于 "\n"：
      定义 acc 等于 acc 加 "\n" 加 indent
    否则：
      定义 acc 等于 acc 加 c
    定义 i 等于 i 加 1
  返回 acc

段落 comp_if 接收 toks, p：
  如果 p 小于 列表长度(toks)：
    定义 tok 等于 列表获取(toks, p)
    如果 列表获取(tok, 1) 等于 "如果"：
      定义 np 等于 p 加 1
      定义 结果 等于 表达式(toks, np)
      定义 cond 等于 列表获取(结果, 0)
      定义 np 等于 列表获取(结果, 1)
      定义 end_p 等于 find_matching_end(toks, np, 1)
      定义 body 等于 compile_block(toks, np, end_p 减 1, "    ", "")
      如果 body 等于 ""：
        定义 body 等于 "    pass\n"
      定义 code 等于 "if " 加 cond 加 ":\n" 加 body
      如果 end_p 小于 列表长度(toks)：
        定义 next_tok 等于 列表获取(toks, end_p)
        如果 列表获取(next_tok, 1) 等于 "否则"：
          定义 else_p 等于 end_p 加 1
          定义 else_end 等于 find_matching_end(toks, else_p, 1)
          定义 else_body 等于 compile_block(toks, else_p, else_end 减 1, "    ", "")
          如果 else_body 等于 ""：
            定义 else_body 等于 "    pass"
          定义 code 等于 code 加 "\nelse:\n" 加 else_body
          返回 列表创建(code, else_end)
      返回 列表创建(code, end_p)
  返回 列表创建("", p)

段落 comp_while 接收 toks, p：
  如果 p 小于 列表长度(toks)：
    定义 tok 等于 列表获取(toks, p)
    如果 列表获取(tok, 1) 等于 "当"：
      定义 np 等于 p 加 1
      定义 结果 等于 表达式(toks, np)
      定义 cond 等于 列表获取(结果, 0)
      定义 np 等于 列表获取(结果, 1)
      定义 end_p 等于 find_matching_end(toks, np, 1)
      定义 body 等于 compile_block(toks, np, end_p 减 1, "    ", "")
      如果 body 等于 ""：
        定义 body 等于 "    pass\n"
      返回 列表创建("while " 加 cond 加 ":\n" 加 body, end_p)
  返回 列表创建("", p)

段落 comp_for 接收 toks, p：
  如果 p 小于 列表长度(toks)：
    定义 tok 等于 列表获取(toks, p)
    如果 列表获取(tok, 1) 等于 "遍历"：
      定义 np 等于 p 加 1
      如果 np 小于 列表长度(toks)：
        定义 var_tok 等于 列表获取(toks, np)
        定义 var_name 等于 列表获取(var_tok, 1)
        定义 np 等于 np 加 1
        如果 np 小于 列表长度(toks)：
          定义 next_tok 等于 列表获取(toks, np)
          如果 列表获取(next_tok, 1) 等于 "在"：
            定义 np 等于 np 加 1
            定义 结果 等于 表达式(toks, np)
            定义 iter_expr 等于 列表获取(结果, 0)
            定义 np 等于 列表获取(结果, 1)
            定义 end_p 等于 find_matching_end(toks, np, 1)
            定义 body 等于 compile_block(toks, np, end_p 减 1, "    ", "")
            如果 body 等于 ""：
              定义 body 等于 "    pass\n"
            返回 列表创建("for " 加 var_name 加 " in " 加 iter_expr 加 ":\n" 加 body, end_p)
  返回 列表创建("", p)

段落 compile_stmts 接收 toks, p, out：
  当 p 小于 列表长度(toks)：
    定义 tok 等于 列表获取(toks, p)
    定义 tv 等于 列表获取(tok, 1)
    定义 已处理 等于 假
    如果 tv 等于 "设"：
      定义 结果 等于 comp_set(toks, p)
      定义 stmt 等于 列表获取(结果, 0)
      定义 np 等于 列表获取(结果, 1)
      定义 out 等于 out 加 "    " 加 stmt 加 "\n"
      定义 p 等于 np
      定义 已处理 等于 真
    如果 已处理 等于 假 且 tv 等于 "如果"：
      定义 结果 等于 comp_if(toks, p)
      定义 stmt 等于 列表获取(结果, 0)
      定义 np 等于 列表获取(结果, 1)
      定义 out 等于 out 加 add_indent(stmt, "    ")
      定义 p 等于 np
      定义 已处理 等于 真
    如果 已处理 等于 假 且 tv 等于 "当"：
      定义 结果 等于 comp_while(toks, p)
      定义 stmt 等于 列表获取(结果, 0)
      定义 np 等于 列表获取(结果, 1)
      定义 out 等于 out 加 add_indent(stmt, "    ")
      定义 p 等于 np
      定义 已处理 等于 真
    如果 已处理 等于 假 且 tv 等于 "遍历"：
      定义 结果 等于 comp_for(toks, p)
      定义 stmt 等于 列表获取(结果, 0)
      定义 np 等于 列表获取(结果, 1)
      定义 out 等于 out 加 add_indent(stmt, "    ")
      定义 p 等于 np
      定义 已处理 等于 真
    如果 已处理 等于 假 且 tv 等于 "返回"：
      定义 结果 等于 find_ret(toks, p)
      定义 stmt 等于 列表获取(结果, 0)
      定义 np 等于 列表获取(结果, 1)
      定义 out 等于 out 加 "    " 加 stmt 加 "\n"
      定义 p 等于 np
      定义 已处理 等于 真
    如果 已处理 等于 假 且 列表获取(tok, 0) 等于 "ID"：
      定义 np 等于 p 加 1
      如果 np 小于 列表长度(toks)：
        定义 ntok 等于 列表获取(toks, np)
        如果 列表获取(ntok, 0) 等于 "LPAREN"：
          定义 结果 等于 表达式(toks, p)
          定义 stmt 等于 列表获取(结果, 0)
          定义 np 等于 列表获取(结果, 1)
          定义 out 等于 out 加 "    " 加 stmt 加 "\n"
          定义 p 等于 np
          定义 已处理 等于 真
        如果 已处理 等于 假 且 列表获取(ntok, 0) 等于 "DOT"：
          定义 结果 等于 表达式(toks, p)
          定义 stmt 等于 列表获取(结果, 0)
          定义 np 等于 列表获取(结果, 1)
          定义 out 等于 out 加 "    " 加 stmt 加 "\n"
          定义 p 等于 np
          定义 已处理 等于 真
    如果 已处理 等于 假 且 列表获取(tok, 0) 等于 "KW" 且 tv 等于 "父"：
      定义 np 等于 p 加 1
      如果 np 小于 列表长度(toks)：
        定义 ntok 等于 列表获取(toks, np)
        如果 列表获取(ntok, 0) 等于 "DOT"：
          定义 结果 等于 表达式(toks, p)
          定义 stmt 等于 列表获取(结果, 0)
          定义 np 等于 列表获取(结果, 1)
          定义 out 等于 out 加 "    " 加 stmt 加 "\n"
          定义 p 等于 np
          定义 已处理 等于 真
    如果 已处理 等于 假 且 tv 等于 "结束"：
      返回 列表创建(out, p 加 1)
    如果 已处理 等于 假 且 是函数关键字(tv)：
      返回 列表创建(out, p)
    如果 已处理 等于 假：
      定义 p 等于 p 加 1
  返回 列表创建(out, p)

段落 解析参数 接收 toks, p：
  如果 p 小于 列表长度(toks)：
    定义 tok 等于 列表获取(toks, p)
    如果 列表获取(tok, 1) 等于 "接收"：
      返回 收集参数(toks, p 加 1, "")
  返回 列表创建("", p)

段落 收集参数 接收 toks, p, acc：
  当 p 小于 列表长度(toks)：
    定义 tok 等于 列表获取(toks, p)
    定义 已处理 等于 假
    如果 列表获取(tok, 0) 等于 "ID"：
      定义 v 等于 列表获取(tok, 1)
      如果 字符串长度(v) 大于 0：
        定义 末字符 等于 字符串获取(v, 字符串长度(v) 减 1)
        如果 末字符 等于 "："：
          定义 v 等于 截取(v, 0, 字符串长度(v) 减 1)
          如果 acc 等于 ""：
            返回 列表创建(v, p 加 1)
          返回 列表创建(acc 加 ", " 加 v, p 加 1)
      如果 acc 等于 ""：
        定义 acc 等于 v
      否则：
        定义 acc 等于 acc 加 ", " 加 v
      定义 p 等于 p 加 1
      定义 已处理 等于 真
    如果 已处理 等于 假 且 列表获取(tok, 0) 等于 "KW"：
      定义 v 等于 列表获取(tok, 1)
      如果 v 等于 "己"：
        如果 acc 等于 ""：
          定义 acc 等于 v
        否则：
          定义 acc 等于 acc 加 ", " 加 v
        定义 p 等于 p 加 1
        定义 已处理 等于 真
    如果 已处理 等于 假 且 列表获取(tok, 0) 等于 "COMMA"：
      定义 p 等于 p 加 1
      定义 已处理 等于 真
    如果 已处理 等于 假：
      返回 列表创建(acc, p)
  返回 列表创建(acc, p)

段落 compile_class 接收 toks, p：
  如果 p 小于 列表长度(toks)：
    定义 tok 等于 列表获取(toks, p)
    如果 列表获取(tok, 1) 等于 "类"：
      定义 np 等于 p 加 1
      定义 name 等于 ""
      如果 np 小于 列表长度(toks)：
        定义 name_tok 等于 列表获取(toks, np)
        定义 name 等于 列表获取(name_tok, 1)
        定义 np 等于 np 加 1
      定义 parent_name 等于 ""
      如果 np 小于 列表长度(toks)：
        定义 next_tok 等于 列表获取(toks, np)
        如果 列表获取(next_tok, 0) 等于 "LPAREN"：
          定义 np 等于 np 加 1
          如果 np 小于 列表长度(toks)：
            定义 parent_tok 等于 列表获取(toks, np)
            定义 parent_name 等于 列表获取(parent_tok, 1)
            定义 np 等于 np 加 1
            如果 np 小于 列表长度(toks)：
              定义 rparen_tok 等于 列表获取(toks, np)
              如果 列表获取(rparen_tok, 0) 等于 "RPAREN"：
                定义 np 等于 np 加 1
      定义 end_p 等于 find_matching_end(toks, np, 1)
      定义 body 等于 compile_class_body(toks, np, end_p 减 1, name)
      如果 body 等于 ""：
        定义 body 等于 "    pass"
      定义 class_def 等于 "class " 加 name
      如果 parent_name 不等于 ""：
        定义 class_def 等于 class_def 加 "(" 加 parent_name 加 ")"
      定义 class_def 等于 class_def 加 ":\n" 加 body
      返回 列表创建(class_def, end_p)
  返回 列表创建("", p)

段落 compile_class_body 接收 toks, p, end_p, class_name：
  定义 out 等于 ""
  当 p 小于 end_p 且 p 小于 列表长度(toks)：
    定义 tok 等于 列表获取(toks, p)
    定义 tv 等于 列表获取(tok, 1)
    定义 已处理 等于 假
    如果 tv 等于 "属性"：
      定义 np 等于 p 加 1
      如果 np 小于 列表长度(toks)：
        定义 p 等于 np 加 1
        定义 已处理 等于 真
    如果 已处理 等于 假 且 是函数关键字(tv)：
      定义 func结果 等于 compile_class_method(toks, p, class_name)
      定义 method_code 等于 列表获取(func结果, 0)
      定义 p 等于 列表获取(func结果, 1)
      定义 out 等于 out 加 method_code
      定义 已处理 等于 真
    如果 已处理 等于 假 且 tv 等于 "结束"：
      返回 out
    如果 已处理 等于 假：
      定义 p 等于 p 加 1
  返回 out

段落 compile_class_method 接收 toks, p, class_name：
  定义 tok 等于 列表获取(toks, p)
  定义 np 等于 p 加 1
  定义 name 等于 ""
  如果 np 小于 列表长度(toks)：
    定义 name_tok 等于 列表获取(toks, np)
    定义 name 等于 列表获取(name_tok, 1)
    定义 np 等于 np 加 1
  定义 参数结果 等于 解析参数(toks, np)
  定义 params 等于 列表获取(参数结果, 0)
  定义 np 等于 列表获取(参数结果, 1)
  定义 final_params 等于 ""
  如果 params 等于 "己"：
    定义 final_params 等于 "self"
  如果 params 不等于 "己" 且 字符串长度(params) 大于等于 2：
    定义 前两字 等于 截取(params, 0, 2)
    如果 前两字 等于 "己,"：
      定义 final_params 等于 "self" 加 截取(params, 1, 字符串长度(params))
  如果 final_params 等于 ""：
    定义 final_params 等于 "self"
    如果 params 不等于 ""：
      定义 final_params 等于 "self, " 加 params
  定义 method_end 等于 find_matching_end(toks, np, 1)
  定义 body 等于 compile_block(toks, np, method_end 减 1, "        ", "")
  如果 body 等于 ""：
    定义 body 等于 "        pass"
  定义 code 等于 "    def " 加 name 加 "(" 加 final_params 加 "):\n" 加 body 加 "\n"
  返回 列表创建(code, method_end)

段落 compile_top 接收 toks, p, out：
  当 p 小于 列表长度(toks)：
    定义 tok 等于 列表获取(toks, p)
    定义 tv 等于 列表获取(tok, 1)
    定义 已处理 等于 假
    如果 tv 等于 "类"：
      定义 结果 等于 compile_class(toks, p)
      定义 class_code 等于 列表获取(结果, 0)
      定义 np 等于 列表获取(结果, 1)
      定义 out 等于 out 加 class_code 加 "\n"
      定义 p 等于 np
      定义 已处理 等于 真
    如果 已处理 等于 假 且 是函数关键字(tv)：
      定义 结果 等于 compile_single_func(toks, p)
      定义 func_code 等于 列表获取(结果, 0)
      定义 np 等于 列表获取(结果, 1)
      定义 out 等于 out 加 func_code
      定义 p 等于 np
      定义 已处理 等于 真
    如果 已处理 等于 假：
      定义 p 等于 p 加 1
  返回 out

段落 compile_single_func 接收 toks, p：
  定义 tok 等于 列表获取(toks, p)
  定义 np 等于 p 加 1
  定义 name 等于 ""
  如果 np 小于 列表长度(toks)：
    定义 tok 等于 列表获取(toks, np)
    如果 列表获取(tok, 0) 等于 "ID"：
      定义 name 等于 列表获取(tok, 1)
      定义 np 等于 np 加 1
  定义 参数结果 等于 解析参数(toks, np)
  定义 params 等于 列表获取(参数结果, 0)
  定义 np 等于 列表获取(参数结果, 1)
  定义 body结果 等于 compile_stmts(toks, np, "")
  定义 body 等于 列表获取(body结果, 0)
  定义 np 等于 列表获取(body结果, 1)
  如果 body 等于 ""：
    定义 body 等于 "    pass\n"
  定义 code 等于 "def " 加 name 加 "(" 加 params 加 "):\n" 加 body 加 "\n"
  返回 列表创建(code, np)

段落 压缩代码 接收 src：
  定义 n 等于 字符串长度(src)
  定义 out 等于 ""
  定义 p 等于 0
  定义 行缓冲 等于 ""
  定义 换行计数 等于 0
  当 p 小于 n：
    定义 c 等于 字符串获取(src, p)
    如果 c 等于 "\n"：
      定义 修剪后 等于 ""
      定义 i 等于 字符串长度(行缓冲) 减 1
      定义 继续循环 等于 真
      当 继续循环 且 i 大于等于 0：
        定义 ch 等于 字符串获取(行缓冲, i)
        如果 ch 不等于 " " 且 ch 不等于 "\t"：
          定义 修剪后 等于 截取(行缓冲, 0, i 加 1)
          定义 继续循环 等于 假
        否则：
          定义 i 等于 i 减 1
      如果 修剪后 等于 ""：
        定义 换行计数 等于 换行计数 加 1
        如果 换行计数 小于等于 1：
          定义 out 等于 out 加 "\n"
      否则：
        定义 换行计数 等于 0
        定义 out 等于 out 加 修剪后 加 "\n"
      定义 行缓冲 等于 ""
    否则：
      定义 行缓冲 等于 行缓冲 加 c
    定义 p 等于 p 加 1
  如果 行缓冲 不等于 ""：
    定义 out 等于 out 加 行缓冲
  返回 out

段落 编译 接收 src：
  定义 header 等于 "# Generated by Duan Level 4\n"
  定义 toks 等于 词法(src)
  定义 code 等于 compile_top(toks, 0, "")
  定义 result 等于 header 加 code
  返回 压缩代码(result)

段落 测试：
  打印 "=== Level 4 测试 ==="
  打印 ""

  打印 "--- 测试1: 基本函数 ---"
  定义 src1 等于 "段落 foo 返回 42 结束"
  打印 "源: " 加 src1
  打印 编译(src1)
  打印 ""

  打印 "--- 测试2: 带变量 ---"
  定义 src2 等于 "段落 bar 设 x 为 10 返回 x 结束"
  打印 "源: " 加 src2
  打印 编译(src2)
  打印 ""

  打印 "--- 测试3: 带if ---"
  定义 src3 等于 "段落 baz 如果 真 返回 1 结束 返回 0 结束"
  打印 "源: " 加 src3
  打印 编译(src3)
  打印 ""

  打印 "Level 4 验证通过！"

段落 主函数：
  打印 "段言 Level 4 启动"
  打印 ""
  测试()

主函数()