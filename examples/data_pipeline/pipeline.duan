# 段言 - 数据管道示例
# CSV → JSON → SQLite 数据转换与存储
# 用法: duan run examples/data_pipeline/pipeline.duan

导入 文件系统。
导入 JSON。

# 硬编码的 CSV 数据
设 CSV数据 为 "姓名,年龄,城市,职业,薪资
张三,28,北京,工程师,15000
李四,32,上海,设计师,18000
王五,25,广州,产品经理,16000
赵六,35,深圳,架构师,25000
钱七,29,杭州,数据分析师,14000
孙八,31,成都,前端开发,13000
周九,27,武汉,后端开发,13500
吴十,33,南京,运维工程师,14500"

# 1. 解析 CSV 数据
段落 解析CSV 接收 文本：
  设 行列表 为 分割字符串(文本, "\n")。
  如果 列表长度(行列表) 小于 2：
    返回 []。

  设 表头 为 分割字符串(行列表[0], ",")。
  设 结果 为 []。

  设 i 为 1。
  当 i 小于 列表长度(行列表)：
    设 行 为 行列表[i]。
    设 字段 为 分割字符串(行, ",")。
    设 记录 为 {}。

    设 j 为 0。
    当 j 小于 列表长度(表头)：
      设 键 为 表头[j]。
      设 值 为 字段[j]。
      字典设置(记录, 键, 值)。
      j 为 j + 1。

    列表追加(结果, 记录)。
    i 为 i + 1。

  返回 结果。

# 2. 转换薪资为整数并计算统计
段落 转换数据 接收 数据：
  设 结果 为 []。
  遍历 记录 于 数据：
    记录["薪资"] 为 转整数(记录["薪资"])。
    记录["年龄"] 为 转整数(记录["年龄"])。
    列表追加(结果, 记录)。

  返回 结果。

# 3. 筛选高薪人员
段落 筛选高薪 接收 数据, 阈值：
  设 结果 为 []。
  遍历 记录 于 数据：
    如果 记录["薪资"] 大于等于 阈值：
      列表追加(结果, 记录)。

  返回 结果。

# 4. 按城市分组
段落 按城市分组 接收 数据：
  设 城市分组 为 {}。
  遍历 记录 于 数据：
    设 城市 为 记录["城市"]。
    如果 字典包含键(城市分组, 城市) 等于 假：
      字典设置(城市分组, 城市, [])。
    设 组 为 字典获取(城市分组, 城市, [])。
    列表追加(组, 记录)。
    字典设置(城市分组, 城市, 组)。

  返回 城市分组。

# 5. 导出为 JSON 文件
段落 导出JSON 接收 数据, 文件路径：
  设 JSON字符串 为 序列化JSON(数据, 2)。
  写入文件(文件路径, JSON字符串)。
  打印("已导出 JSON 文件: " + 文件路径)。

# 6. 存储到 SQLite 数据库
段落 存储到SQLite 接收 数据：
  设 数据库 为 打开数据库("pipeline.db")。
  数据库.创建表("employees", {
    "姓名": "TEXT",
    "年龄": "INTEGER",
    "城市": "TEXT",
    "职业": "TEXT",
    "薪资": "INTEGER"
  }, ["姓名"])。

  遍历 记录 于 数据：
    数据库.插入("employees", 记录)。

  打印("已存储 " + 转字符串(列表长度(数据)) + " 条记录到 SQLite 数据库。")。

# 7. 查询并显示结果
段落 查询并显示 接收 数据库：
  打印("\n===== 所有员工数据 =====")。
  设 所有员工 为 数据库.查询("SELECT * FROM employees")。
  遍历 员工 于 所有员工：
    打印(转字符串(员工["姓名"]) + " | " + 转字符串(员工["年龄"]) + "岁 | " + 员工["城市"] + " | " + 员工["职业"] + " | 薪资: " + 转字符串(员工["薪资"]) + "元")。

  打印("\n===== 薪资统计 =====")。
  设 薪资统计 为 数据库.查询("SELECT AVG(薪资) as 平均薪资, MAX(薪资) as 最高薪资, MIN(薪资) as 最低薪资, COUNT(*) as 人数 FROM employees")。
  如果 列表长度(薪资统计) 大于 0：
    设 统计 为 薪资统计[0]。
    打印("平均薪资: " + 转字符串(统计["平均薪资"]) + "元")。
    打印("最高薪资: " + 转字符串(统计["最高薪资"]) + "元")。
    打印("最低薪资: " + 转字符串(统计["最低薪资"]) + "元")。
    打印("员工人数: " + 转字符串(统计["人数"]) + "人")。

  打印("\n===== 按城市分组 =====")。
  设 城市数据 为 数据库.查询("SELECT 城市, COUNT(*) as 人数, AVG(薪资) as 平均薪资 FROM employees GROUP BY 城市")。
  遍历 行 于 城市数据：
    打印(行["城市"] + ": " + 转字符串(行["人数"]) + "人, 平均薪资 " + 转字符串(行["平均薪资"]) + "元")。

  数据库.关闭()。

# 主程序
段落 主程序：
  打印("=== 数据管道: CSV → JSON → SQLite ===")。

  # 步骤 1: 解析 CSV
  打印("\n[1/5] 解析 CSV 数据...")。
  设 数据 为 解析CSV(CSV数据)。
  打印("解析了 " + 转字符串(列表长度(数据)) + " 条记录。")。

  # 步骤 2: 转换数据
  打印("\n[2/5] 转换数据类型...")。
  设 转换后数据 为 转换数据(数据)。

  # 步骤 3: 导出为 JSON
  打印("\n[3/5] 导出为 JSON 格式...")。
  导出JSON(转换后数据, "employees.json")。

  # 步骤 4: 存储到 SQLite
  打印("\n[4/5] 存储到 SQLite 数据库...")。
  存储到SQLite(转换后数据)。

  # 步骤 5: 查询并显示
  打印("\n[5/5] 查询数据库并显示结果...")。
  设 数据库 为 打开数据库("pipeline.db")。
  查询并显示(数据库)。

  # 额外: 筛选高薪人员
  打印("\n===== 高薪人员 (>= 16000元) =====")。
  设 高薪人员 为 筛选高薪(转换后数据, 16000)。
  遍历 高薪 于 高薪人员：
    打印(高薪["姓名"] + " - " + 高薪["职业"] + " - " + 转字符串(高薪["薪资"]) + "元")。

  打印("\n数据管道执行完成！")。

主程序()。