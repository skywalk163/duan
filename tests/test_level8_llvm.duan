// Level 8 - LLVM后端完整支持 测试程序
// 测试类型注解、类型优化、段落函数指针传递等功能

// 1. 类型注解变量声明
变量 甲：数 = 10
变量 乙：数 = 20
变量 丙：浮点数 = 3.14
变量 丁：布尔 = 真
变量 戊：串 = "hello"

// 2. 整数算术运算（类型优化：直接使用i64运算）
输出 "=== 整数算术测试 ==="
输出 "甲 + 乙 = " + 转串(甲 + 乙)
输出 "甲 - 乙 = " + 转串(甲 - 乙)
输出 "甲 * 乙 = " + 转串(甲 * 乙)
输出 "乙 / 甲 = " + 转串(乙 / 甲)

// 3. 比较运算（类型优化：直接icmp）
输出 ""
输出 "=== 比较运算测试 ==="
输出 "甲 < 乙 = " + 转串(甲 < 乙)
输出 "甲 > 乙 = " + 转串(甲 > 乙)
输出 "甲 == 10 = " + 转串(甲 == 10)
输出 "乙 != 20 = " + 转串(乙 != 20)
输出 "甲 <= 乙 = " + 转串(甲 <= 乙)
输出 "乙 >= 甲 = " + 转串(乙 >= 甲)

// 4. 浮点运算（类型优化：直接使用double运算）
输出 ""
输出 "=== 浮点运算测试 ==="
变量 半径：浮点数 = 5.0
变量 面积：浮点数 = 3.14159 * 半径 * 半径
输出 "半径 = " + 转串(半径)
输出 "面积 = " + 转串(面积)

// 5. 条件分支（类型优化：直接判断条件）
输出 ""
输出 "=== 条件分支测试 ==="
如果 甲 < 乙：
    输出 "甲 小于 乙"
否则：
    输出 "甲 大于等于 乙"

// 6. 循环测试
输出 ""
输出 "=== 循环测试 ==="
变量 总和：数 = 0
变量 计数：数 = 1
当 计数 <= 10：
    总和 = 总和 + 计数
    计数 = 计数 + 1
输出 "1到10的和 = " + 转串(总和)

// 7. 段落函数（指针传递）
输出 ""
输出 "=== 段落函数测试 ==="

段落 加法(a, b)：
    返回 a + b

段落 阶乘(n)：
    如果 n <= 1：
        返回 1
    返回 n * 阶乘(n - 1)

输出 "加法(3, 4) = " + 转串(加法(3, 4))
输出 "阶乘(5) = " + 转串(阶乘(5))

// 8. 列表操作
输出 ""
输出 "=== 列表操作测试 ==="
变量 列表 = [1, 2, 3, 4, 5]
输出 "列表长度 = " + 转串(长度(列表))
输出 "列表[2] = " + 转串(列表[2])

// 9. 类型推断测试（无显式类型注解）
输出 ""
输出 "=== 类型推断测试 ==="
变量 x = 100
变量 y = 200
输出 "x + y = " + 转串(x + y)
输出 "x < y = " + 转串(x < y)

输出 ""
输出 "=== Level 8 测试完成 ==="
